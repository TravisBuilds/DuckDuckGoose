{
 "schema_version": 1,
 "checked": "2026-10-19",
 "recheck_interval_days": 30,
 "precedence": "When Higgsfield and the upstream vendor differ, value = the stricter one (basis says which). 'unknown' = no official value: preflight never refuses on it, only shows it.",
 "shared": {
  "higgsfield": {
   "upload_content_types": [
    "image/jpeg",
    "image/png",
    "image/webp",
    "image/gif",
    "audio/wav",
    "audio/x-wav",
    "video/mp4"
   ],
   "upload_url_ttl_s": 3600,
   "output_retention_days_min": 7,
   "failed_or_nsfw_charged": false,
   "concurrency_error": "400 'Maximum number of concurrent requests (N) has been reached'",
   "sources": [
    "hf_uploads",
    "hf_billing",
    "hf_errors",
    "hf_rate"
   ]
  }
 },
