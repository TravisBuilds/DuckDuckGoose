# ============================================================================
# Hands-Free Video Generator - Environment Configuration
# ============================================================================
#
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets to git
#

# ============================================================================
# API SECURITY (REQUIRED)
# ============================================================================

# Admin secret for API authentication (REQUIRED, NO DEFAULT - fail closed)
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Minimum 32 characters required
ADMIN_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REQUIRED

# ============================================================================
# TEMPORAL CONFIGURATION
# ============================================================================

# Temporal server address
TEMPORAL_ADDRESS=localhost:7233

# Temporal namespace
TEMPORAL_NAMESPACE=default

# ============================================================================
# DATABASE
# ============================================================================

# SQLite database path (default: ./data/studio.db)
DATABASE_PATH=./data/studio.db

# ============================================================================
# GENERATION MODE
# ============================================================================

# Dry run mode: true = no provider calls, false = live mode with real spend
# Default: true (safe default)
DRY_RUN=true

# ============================================================================
# PROVIDER API KEYS (Optional for dry-run, REQUIRED for live mode)
# ============================================================================

# Higgsfield API key for still and video generation
# Format: id:secret (both parts required)
HIGGSFIELD_API_KEY=

# OpenAI API key for vision-based QC judge
OPENAI_API_KEY=

# ElevenLabs API key for audio generation (voiceover, music, SFX)
ELEVENLABS_API_KEY=

# ============================================================================
# MODEL PATHS (Optional, defaults provided)
# ============================================================================

# Still image generation model
MODEL_PATH_STILL=xai/grok-imagine-image-2.0

# Still image fallback model
MODEL_PATH_STILL_FALLBACK=alibaba/qwen-image-3/edit

# Kling video generation model
MODEL_PATH_KLING=kling-video/v3.0/pro/image-to-video

# Seedance video generation model
MODEL_PATH_SEEDANCE=bytedance/seedance-2.5/image-to-video

# ============================================================================
# G1 CLIP ESTIMATION (REQUIRED for live G1 approval)
# ============================================================================

# Public image URL used as placeholder for clip cost estimates
# Required in live mode (1080x1920 recommended)
# If unset, G1 clip estimates are marked unavailable and G1 refuses to proceed
G1_ESTIMATE_PLACEHOLDER_IMAGE_URL=

# ============================================================================
# EPISODE DATA DIRECTORIES
# ============================================================================

# Episode data directory (beatmaps, shots, assets)
EPISODES_DIR=./data/episodes

# Normalized reference image cache directory
NORMALIZED_CACHE_DIR=./data/normalized

# Upload cache database path
UPLOAD_CACHE_DB_PATH=./data/upload_cache.db

# ============================================================================
# REFERENCE IMAGE NORMALIZATION (Optional overrides)
# ============================================================================

# Maximum long side dimension for normalized reference images (pixels)
REF_MAX_LONG_SIDE=1280

# Maximum file size for normalized reference images (bytes)
REF_MAX_BYTES=1048576

# ============================================================================
# BUDGET CONFIGURATION (Optional, defaults provided)
# ============================================================================

# Default episode budget cap in USD (decimal string)
# Default: "60.00" ($60.00 USD)
DEFAULT_EPISODE_CAP_USD=60.00

# GC.01 headroom requirement in USD (decimal string)
# Minimum balance required after all holds
# Default: "12.00" ($12.00 USD)
GC01_HEADROOM_USD=12.00

# Stop threshold percentage (0-100)
# Blocks new reserves at this percentage of cap
# Default: 80 (80% of cap)
STOP_THRESHOLD_PERCENT=80

# ============================================================================
# MODEL CAPABILITIES REGISTRY
# ============================================================================

# Path to model capabilities JSON file
# Default: hfvg/data/model_caps.json (packaged with code)
MODEL_CAPS_PATH=

# Per-model reference count overrides (JSON)
# Format: {"model-path": max_refs}
# Example: {"xai/grok-imagine-image-2.0": 8}
MODEL_MAX_REFS_JSON=

# ============================================================================
# SHOT RETRY CONFIGURATION
# ============================================================================

# Maximum number of retries per shot
# Default: 3
MAX_SHOT_RETRIES=3

# ============================================================================
# FILE PATHS (Optional overrides for testing)
# ============================================================================

# Per-shot data file (shots.json)
SHOTS_JSON_PATH=

# Reference images registry (refs.json)
REFS_JSON_PATH=

# Prompt kit file (prompt_kit.json)
PROMPT_KIT_PATH=

# ============================================================================
# WEB SERVER (FastAPI)
# ============================================================================

# Server port
PORT=8000

# CORS allowed origins (comma-separated)
# Default: * (all origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# TESTING (Only used in test environment)
# ============================================================================

# Require ffmpeg for motion QC tests
# Set to "1" to require, unset or "0" to skip motion tests
REQUIRE_FFMPEG=

# ============================================================================
# ADVANCED CONFIGURATION (Rarely changed)
# ============================================================================

# Dry run still generation delay in seconds (simulated)
DRY_RUN_STILL_DELAY=2.0

# Dry run clip generation delay in seconds (simulated)
DRY_RUN_CLIP_DELAY=5.0

# Dry run failure injection rate (0.0 - 1.0)
DRY_RUN_FAILURE_RATE=0.0

# ============================================================================
# NOTES
# ============================================================================
#
# 1. ADMIN_SECRET is REQUIRED and has no default (fail closed)
#    Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# 2. For DRY_RUN=false (live mode), provider API keys are REQUIRED
#
# 3. G1_ESTIMATE_PLACEHOLDER_IMAGE_URL is REQUIRED for live G1 approval
#    (pricing doesn't depend on content, just need a valid image URL)
#
# 4. All USD amounts are decimal strings (e.g., "60.00" not 60)
#
# 5. MODEL_MAX_REFS_JSON example: {"xai/grok-imagine-image-2.0": 8}
#    Overrides per-model reference limits from model_caps.json
#
# 6. CORS_ORIGINS should include your web UI domain in production
#
# 7. Never commit this file with real secrets to git
#    Use environment variable injection in production (Docker, K8s, etc.)
#
# ============================================================================
