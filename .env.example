# DuckDuckGoose Environment Variables

# ============================================================================
# REQUIRED: Admin Secret (Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
# ============================================================================
ADMIN_SECRET=your-secret-here-minimum-32-characters

# ============================================================================
# Backend API (api/main.py)
# ============================================================================

# Temporal connection
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Database
DATABASE_PATH=./data/studio.db

# OpenAI Vision (optional - escalates if missing)
# OPENAI_API_KEY=sk-...

# Dry run mode (default: true for safety)
DRY_RUN=true

# API port
PORT=8000

# ============================================================================
# Frontend Console (web/)
# ============================================================================

# Admin secret (same as backend)
STUDIO_ADMIN_SECRET=your-secret-here-minimum-32-characters

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# Higgsfield Provider (if using real generation)
# ============================================================================

# HIGGSFIELD_API_KEY=your-key-here

# ============================================================================
# Episode Data (NOT committed to public repo)
# ============================================================================

# Path to private episode data directory
# EPISODE_DATA_PATH=/path/to/private/episodes

# ============================================================================
# Production Notes
# ============================================================================

# 1. NEVER commit ADMIN_SECRET or API keys to the repository
# 2. Use strong secrets (min 32 characters)
# 3. Rotate secrets periodically
# 4. In production, use HTTPS only
# 5. Episode data (beatmaps, continuity) must be uploaded at runtime
