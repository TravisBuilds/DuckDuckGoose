# Studio API Configuration

# Admin secret (REQUIRED, NO DEFAULT - fail closed)
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REQUIRED

# Temporal connection
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Database
DATABASE_PATH=./data/studio.db

# Provider API keys (optional for dry-run, required for live mode)
HIGGSFIELD_API_KEY=
OPENAI_API_KEY=

# Generation mode (default: dry run with fake providers)
DRY_RUN=true

# Still image model (default: xai/grok-imagine-image-2.0)
MODEL_PATH_STILL=xai/grok-imagine-image-2.0
MODEL_PATH_STILL_FALLBACK=alibaba/qwen-image-3/edit

# Server
PORT=8000
