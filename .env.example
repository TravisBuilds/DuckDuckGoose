# ============================================================================
# Hands-Free Video Generator - Environment Configuration
# ============================================================================
#
# Copy this file to .env and fill in your values.
# NOTE: nothing in hfvg/ or api/ loads .env automatically. Export it into the
# shell that runs the API, the worker and the CLI, e.g.:
#   set -a; source .env; set +a
# NEVER commit .env with real secrets to git.
#
# Every variable read by hfvg/, api/ or web/ is listed here. Lines starting
# with "# VAR=" are optional; the value shown is the code default.
#

# ============================================================================
# PROJECT
# ============================================================================

# Gate policy project: examples/<HFVG_PROJECT>/HARNESS-GATES.json (letters, digits, . _ -)
# HFVG_PROJECT=demo

# ============================================================================
# API SECURITY (REQUIRED)
# ============================================================================

# Admin secret for API authentication (REQUIRED, NO DEFAULT - fail closed)
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Minimum 32 characters required. Also read by `hfvg start-v2` (sent as Bearer token).
ADMIN_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REQUIRED

# ============================================================================
# TEMPORAL CONFIGURATION
# ============================================================================

# Temporal server address used by the API (api/main.py)
TEMPORAL_ADDRESS=localhost:7233

# Temporal server address used by the worker (hfvg/worker.py) and the CLI (hfvg/cli.py)
TEMPORAL_HOST=localhost:7233

# Temporal namespace (API, worker and CLI)
TEMPORAL_NAMESPACE=default

# Worker task queue
# TASK_QUEUE=hfvg-tasks

# ============================================================================
# DATABASE
# ============================================================================

# SQLite database path (default: ./data/studio.db). Also holds the upload cache,
# the dollar ledger, sessions and the run lock.
DATABASE_PATH=./data/studio.db

# Legacy credit ledger database (hfvg/ledger.py, default: hfvg.db)
# DB_PATH=hfvg.db

# ============================================================================
# GENERATION MODE
# ============================================================================

# Dry run mode: true = no provider calls (kill switch), false = live allowed.
# Live also needs the per-episode switch (POST /api/episodes/{id}/set-live with
# confirmation "ENABLE_LIVE_MODE") and G1 approval (G1.08 credit plan).
# Default: true (safe default)
DRY_RUN=true

# ============================================================================
# PROVIDER API KEYS (Optional for dry-run, REQUIRED for live mode)
# ============================================================================

# Higgsfield API key for still and video generation
# Format: id:secret (both parts required)
HIGGSFIELD_API_KEY=

# Higgsfield API base URL
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# Optional Higgsfield preset id (hfvg/providers/common.py)
# HIGGSFIELD_DECLINED_PRESET_ID=

# OpenAI API key: NOT read by the current code (no OpenAI judge is wired;
# live QC escalates to human review). Reserved for a future vision judge.
OPENAI_API_KEY=

# ElevenLabs API key for audio generation (read by the ElevenLabs SDK from the environment)
ELEVENLABS_API_KEY=
# USD per ElevenLabs credit used to reserve and to price the character-cost header (G-AUD-COST).
# Default 0.0002 = Starter ($6 / 30k credits), the highest paid per-credit price; set your plan's
# price / included credits (e.g. Creator 22/121000 = 0.000182) for exact accounting.
# ELEVENLABS_USD_PER_CREDIT=0.0002

# ============================================================================
# MODEL PATHS (Optional, defaults provided)
# ============================================================================

# Still image generation model
MODEL_PATH_STILL=xai/grok-imagine-image-2.0

# Soul V2 still model path
# MODEL_PATH_SOUL_V2=higgsfield-ai/soul/v2/standard

# Legacy GPT Image 2 path (not in the public API; empty by default)
# MODEL_PATH_GPT_IMAGE_2=

# Kling video generation model
MODEL_PATH_KLING=kling-video/v3.0/pro/image-to-video

# Seedance video generation model
MODEL_PATH_SEEDANCE=bytedance/seedance-2.5/image-to-video

# ============================================================================
# G1 CLIP ESTIMATION (REQUIRED for live G1 approval)
# ============================================================================

# Public image URL used as placeholder for clip cost estimates
# Required in live mode (1080x1920 recommended)
# If unset, G1 clip estimates are marked unavailable and G1 refuses to proceed
G1_ESTIMATE_PLACEHOLDER_IMAGE_URL=

# ============================================================================
# EPISODE DATA DIRECTORIES
# ============================================================================

# Episode data directory (beatmaps, shots, assets)
EPISODES_DIR=./data/episodes

# General data directory (lead refs are written to <DATA_DIR>/lead_refs)
# DATA_DIR=./data

# Normalized reference image cache directory
NORMALIZED_CACHE_DIR=./data/normalized

# Asset registry roots
# SERIES_PATH=./series
# EPISODE_PATH=./episode

# ============================================================================
# REFERENCE IMAGE NORMALIZATION (Optional overrides)
# ============================================================================

# Maximum long side dimension for normalized reference images (pixels)
REF_MAX_LONG_SIDE=1280

# Maximum file size for normalized reference images (bytes)
REF_MAX_BYTES=1048576

# JPEG quality search range used while normalizing
# JPEG_QUALITY_START=88
# JPEG_QUALITY_MIN=65

# ============================================================================
# DOLLAR BUDGET (Optional, defaults provided; see docs/DOLLAR-LEDGER.md)
# ============================================================================

# Episode budget cap in USD (decimal string). Default: "60.00"
EPISODE_CAP_USD=60.00

# Episode stop, percent of the cap (integer). Default: 80 -> $48.00 stop on a $60.00 cap.
# Past the stop a reserve returns False; past a cap it raises. Each line has its own 80% stop.
EPISODE_STOP_PERCENT=80

# GC.01 headroom in USD: minimum manual balance left after all holds. Default: "5.00"
GC01_HEADROOM_USD=5.00

# Revision reserve line L7_revision in USD, outside the episode cap, only usable
# with the approval tag "revision". Default: "10.00"
REVISION_RESERVE_USD=10.00

# ============================================================================
# BALANCE MONITORING AND ALERTS (Round 8)
# ============================================================================

# Balance reserve percentage above estimate for preflight gates (default 20%)
# BALANCE_RESERVE_PERCENT=20

# Balance thresholds for alerts (USD)
# BALANCE_LOW_THRESHOLD_USD=10.0
# BALANCE_CRITICAL_THRESHOLD_USD=5.0

# Higgsfield manual balance max age (hours) before stale warning
# HFVG_BALANCE_MAX_AGE_HOURS=24

# Auto top-up flags: set to 'true' if provider auto top-up is enabled
# (with auto top-up on, low balance warns but doesn't block)
# HIGGSFIELD_AUTO_TOPUP_ENABLED=false
# ELEVENLABS_AUTO_TOPUP_ENABLED=false

# Email alert configuration (SMTP)
# BALANCE_ALERT_SMTP_HOST=
# BALANCE_ALERT_SMTP_PORT=587
# BALANCE_ALERT_SMTP_USER=
# BALANCE_ALERT_SMTP_PASSWORD=
# BALANCE_ALERT_SMTP_FROM=
# BALANCE_ALERT_SMTP_TO=

# Webhook URL for alerts (e.g., Slack incoming webhook)
# BALANCE_ALERT_WEBHOOK_URL=

# Alert deduplication window (seconds)
# BALANCE_ALERT_DEDUPE_WINDOW_SECONDS=3600

# Optional spend ceiling alerts (USD)
# DAILY_SPEND_CEILING_USD=
# MONTHLY_SPEND_CEILING_USD=

# Per-second USD rate table override (JSON, integer micro-dollars)
# MODEL_USD_PER_SECOND_JSON=

# ============================================================================
# LEGACY CREDIT LEDGER (hfvg/credit_ledger.py, hfvg/config.py)
# ============================================================================

# EPISODE_CAP_CREDITS=500
# PAUSE_PERCENT=90
# INITIAL_CREDIT_BALANCE=10000.0
# LOW_BALANCE_THRESHOLD=1000.0

# ============================================================================
# MODEL CAPABILITIES REGISTRY
# ============================================================================

# Path to model capabilities JSON file
# Default: hfvg/data/model_caps.json (packaged with code)
MODEL_CAPS_PATH=

# Per-model reference count overrides (JSON). May only LOWER a registry cap
# unless MODEL_CAPS_ALLOW_RAISE=1.
# Format: {"model-path": max_refs}
# Example: {"xai/grok-imagine-image-2.0": 4}
MODEL_MAX_REFS_JSON=

# Allow MODEL_MAX_REFS_JSON to raise a registry cap (set to 1)
# MODEL_CAPS_ALLOW_RAISE=

# ============================================================================
# SHOT RETRY / RUN LOCK / SMOKE GATE
# ============================================================================

# Maximum number of retries per shot (not counting the original attempt)
# Default: 1 (= 2 total attempts)
MAX_SHOT_RETRIES=1

# Seconds after which an account run lock is considered stale
# RUN_LOCK_STALE_TIMEOUT_SECONDS=3600

# Live smoke-test gate: max age of a passing smoke test, and an explicit override
# SMOKE_TEST_MAX_AGE_HOURS=24
# SMOKE_TEST_OVERRIDE=false

# ============================================================================
# FILE PATHS (Optional overrides for testing)
# ============================================================================

# Per-shot data file (shots.json)
SHOTS_JSON_PATH=

# Reference images registry (refs.json)
REFS_JSON_PATH=

# Prompt lint kit file (default: <EPISODES_DIR>/<episode>/prompt_kit.json "lint" section)
PROMPT_LINT_KIT_PATH=

# ============================================================================
# WEB SERVER (FastAPI)
# ============================================================================

# Server port (only used when running `python api/main.py`; uvicorn uses --port)
PORT=8000

# CORS allowed origins (comma-separated)
# Default: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# CLI / WEB UI / SCRIPTS
# ============================================================================

# API base URL used by `hfvg start-v2`
# HFVG_API_BASE=http://localhost:8000

# Web UI (web/): API URL and admin secret for the studio console
# NEXT_PUBLIC_API_URL=http://localhost:8000
# STUDIO_ADMIN_SECRET=

# scripts/e2e_dryrun_ui.py
# API_URL=http://localhost:8000
# WEB_URL=http://localhost:3000

# Audit-log user name (hfvg/studio_db.py; normally the OS USER)
# USER=system

# ============================================================================
# TESTING (Only used in test environment)
# ============================================================================

# Require ffmpeg for motion QC tests
# Set to "1" to require, unset or "0" to skip motion tests
REQUIRE_FFMPEG=

# ============================================================================
# DRY-RUN SIMULATION (Rarely changed; values are the code defaults)
# ============================================================================

# Simulated delays in seconds
DRY_RUN_STILL_DELAY=0.05
DRY_RUN_CLIP_DELAY=0.1
# DRY_RUN_QC_DELAY=0.02
# DRY_RUN_MEDIA_DELAY=0.05
# DRY_RUN_AUDIO_DELAY=0.05

# Failure injection rates (0.0 - 1.0)
DRY_RUN_FAILURE_RATE=0.0
# DRY_RUN_CONTENT_BLOCK_RATE=0.0
# DRY_RUN_STALL_RATE=0.0

# ============================================================================
# RECOVERY (Round 2): moderation ladder, reconciler, stall watchdog
# ============================================================================

# Stall watchdog: a 'reserved' job with no ledger progress for this many minutes raises a
# stall alert (GET /api/stalls) and is routed to the reconciler. Must be positive.
# STALL_THRESHOLD_MINUTES=45
# Reconciler Temporal Schedule (created/updated by the worker on start)
# RECONCILE_INTERVAL_MINUTES=15
# RECONCILE_SCHEDULE_ENABLED=true
# Moderation recovery ladder fallback routing for blocked clips ("from:to,...")
# MODERATION_FALLBACK_MODELS=seedance:kling

# ============================================================================
# NOTES
# ============================================================================
#
# 1. ADMIN_SECRET is REQUIRED and has no default (fail closed)
#    Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# 2. For DRY_RUN=false (live mode), provider API keys are REQUIRED
#
# 3. G1_ESTIMATE_PLACEHOLDER_IMAGE_URL is REQUIRED for live G1 approval
#    (pricing doesn't depend on content, just need a valid image URL)
#
# 4. USD amounts are decimal strings (e.g., "60.00"); the ledger stores integer usd_micros
#
# 5. MODEL_MAX_REFS_JSON overrides per-model reference limits from model_caps.json
#    (lower only, unless MODEL_CAPS_ALLOW_RAISE=1)
#
# 6. CORS_ORIGINS should include your web UI domain in production
#
# 7. Never commit .env with real secrets to git
#    Use environment variable injection in production (Docker, K8s, etc.)
#
# ============================================================================
